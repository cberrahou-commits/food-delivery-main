# ========================================================
# CONFIGURATION DU SERVICE WHATSAPP NOTIFICATIONS
# ========================================================

# Fournisseur actif : "meta" ou "twilio"
WHATSAPP_PROVIDER=meta

# --------------------------------------------------------
# 1. OPTION META WHATSAPP CLOUD API (Recommandé & Officiel)
# Obtenu sur https://developers.facebook.com
# --------------------------------------------------------
# ID du numéro de téléphone fourni par Meta (ex: 108923456789012)
META_PHONE_NUMBER_ID=VOTRE_PHONE_NUMBER_ID

# Token d'accès (Temporaire ou Permanent généré sur Meta Business)
META_ACCESS_TOKEN=EAAG...VOTRE_ACCESS_TOKEN

# Nom du template WhatsApp approuvé (par défaut 'hello_world' pour tester sans attendre)
# Pour des messages libres hors fenêtre 24h, Meta impose un template approuvé
META_TEMPLATE_NAME=order_update_notification
META_TEMPLATE_LANG=fr

# --------------------------------------------------------
# 2. OPTION TWILIO WHATSAPP API (Alternative de test rapide)
# Obtenu sur https://console.twilio.com
# --------------------------------------------------------
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
# Numéro WhatsApp Sandbox Twilio (par défaut +1 415 523 8886)
TWILIO_PHONE_NUMBER=whatsapp:+14155238886

# --------------------------------------------------------
# CONFIGURATION FIREBASE (Écoute des commandes Firestore)
# --------------------------------------------------------
FIREBASE_API_KEY=AIzaSyCHWynUsudT89nbd4XaRTHsajjlxL-WmNs
FIREBASE_AUTH_DOMAIN=food-delivery-prod-b474f.firebaseapp.com
FIREBASE_PROJECT_ID=food-delivery-prod-b474f
FIREBASE_STORAGE_BUCKET=food-delivery-prod-b474f.appspot.com
FIREBASE_MESSAGING_SENDER_ID=804475459341
FIREBASE_APP_ID=1:804475459341:web:d2ea31b0fc216e5428a2a8

